    "resuming normal operations", "configured --", "server built", "apache/", "caught",
    "sigterm", "sighup", "graceful", "restart", "shutting down", "child pid", "exit",
    "parent: pid", "server startup", "mpm", "scoreboard", "segfault", "core"
]

hits = {t: [] for t in lifecycle_terms}
for i,ln in enumerate(lines):
