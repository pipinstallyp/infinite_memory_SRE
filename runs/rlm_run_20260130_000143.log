import re, collections
lines = log_content.splitlines()

# --- Helpers ---
msg_re = re.compile(r'^\[[^\]]+\]\s+\[[^\]]+\]\s+(.*)$')
level_re = re.compile(r'^\[[^\]]+\]\s+\[([^\]]+)\]')

def body(ln):
    m = msg_re.match(ln)
    return m.group(1) if m else ln

def level(ln):
    m = level_re.match(ln)
    return m.group(1).lower() if m else None

# --- 1) Summarize notice/error messages excluding jk spam ---
exclude_substrings = [
    'jk2_init() found child',
    'mod_jk child workerenv in error state',
    'workerenv.init() ok',
]

def is_excluded(ln):
    low = ln.lower()
    return any(s in low for s in exclude_substrings)

filtered = [ln for ln in lines if level(ln) in ('notice','error','warn') and not is_excluded(ln)]
print('Filtered non-spam notice/error/warn lines:', len(filtered))
print('\nFirst 40 filtered lines:')
print('\n'.join(filtered[:40]))

cnt = collections.Counter(body(ln) for ln in filtered)
print('\nTop 40 distinct filtered messages:')
for msg,c in cnt.most_common(40):
    print(f"{c:4d}  {msg[:200]}")

# --- 2) Check whether workerEnv.init() is immediately followed by error state ---
init_idxs = [i for i,ln in enumerate(lines) if 'workerenv.init() ok' in ln.lower()]
followed_by_err = 0
follow_states = collections.Counter()
for i in init_idxs:
    if i+1 < len(lines) and 'mod_jk child workerenv in error state' in lines[i+1].lower():
        followed_by_err += 1
        m = re.search(r'error state\s+(\d+)', lines[i+1].lower())
        if m:
            follow_states[int(m.group(1))] += 1

print('\nworkerEnv.init() ok count:', len(init_idxs))
print('... immediately followed by workerEnv error state:', followed_by_err)
if init_idxs:
    print('Immediate-follow state distribution:', dict(sorted(follow_states.items())))

# Show a few cases where init is NOT followed by error state (if any)
not_followed = [i for i in init_idxs if not (i+1 < len(lines) and 'mod_jk child workerenv in error state' in lines[i+1].lower())]
print('\nInit lines NOT immediately followed by error state:', len(not_followed))
for idx in not_followed[:5]:
    print('\nContext around init-not-followed at line', idx)
    start=max(0,idx-3); end=min(len(lines), idx+6)
    print('\n'.join(lines[start:end]))

# --- 3) Print only the key scoreboard/init error clusters context, but compact ---
init_minus2 = [i for i,ln in enumerate(lines) if 'mod_jk child init 1 -2' in ln.lower()]
cantfind = [i for i,ln in enumerate(lines) if "can't find child" in ln.lower()]

def cluster(idxs, gap=30):
    idxs=sorted(idxs)
    out=[]
    cur=[]
    for x in idxs:
        if not cur or x-cur[-1] <= gap:
            cur.append(x)
        else:
            out.append(cur); cur=[x]
    if cur: out.append(cur)
    return out

print('\ninit -2 clusters:', [(c[0], c[-1], len(c)) for c in cluster(init_minus2)])
print("can't-find-child clusters:", [(c[0], c[-1], len(c)) for c in cluster(cantfind)])

# Print a compact context: only lines in window that are errors/notices other than Found child spam
for label, clusters in [('init-2', cluster(init_minus2)), ('cant-find', cluster(cantfind))]:
    print(f"\n=== Compact context for {label} clusters ===")
    for cl in clusters:
        center = cl[0]
        start=max(0, center-20); end=min(len(lines), center+20)
        window = []
        for j in range(start, end):
            low = lines[j].lower()
            if 'jk2_init() found child' in low:
                continue
            window.append(lines[j])
        print(f"\n-- cluster starting at line {center} --")
        print('\n'.join(window[:80]))

# --- 4) Sub-LLM: interpret codes + infer likely root cause from excerpt ---
excerpt_lines = []
# Use first cluster around 17:43
if cantfind:
    c0 = cantfind[0]
