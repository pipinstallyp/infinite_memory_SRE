import re, collections
lines = log_content.splitlines()

# --- helpers ---
ts_re = re.compile(r'^\[([^\]]+)\]')

def get_ts(ln):
    m = ts_re.match(ln)
    return m.group(1) if m else None

# --- 1) Find lifecycle / restart / startup related lines ---
lifecycle_patterns = [
    r"resuming normal operations",
    r"configured --",
    r"server built",
    r"apache/",          # banner lines
    r"caught sig(term|hup)",
    r"sigterm",
    r"sighup",
    r"graceful",
    r"restart",
    r"shutting down",
    r"parent: pid",
    r"child pid",
    r"mpm",
    r"scoreboard",
    r"exit signal",
    r"segmentation fault",
]

lifecycle_hits = []
for i, ln in enumerate(lines):
    low = ln.lower()
    for pat in lifecycle_patterns:
        if re.search(pat, low):
            lifecycle_hits.append((i, ln))
            break

print("Lifecycle-related lines:", len(lifecycle_hits))
print("First 25 lifecycle-related lines:")
for i, ln in lifecycle_hits[:25]:
    print(i, ln)

# show distinct lifecycle messages (normalized)
msg_re = re.compile(r'^\[[^\]]+\]\s+\[[^\]]+\]\s+(.*)$')
msgs = []
for _, ln in lifecycle_hits:
    m = msg_re.match(ln)
    msgs.append(m.group(1) if m else ln)

print("\nTop lifecycle messages:")
for msg, cnt in collections.Counter(msgs).most_common(20):
    print(f"{cnt:4d}  {msg[:160]}")

# --- 2) Correlate lifecycle lines with jk2 scoreboard/init clusters ---
init_err_idxs = [i for i,ln in enumerate(lines) if "mod_jk child init 1 -2" in ln.lower()]
cantfind_idxs = [i for i,ln in enumerate(lines) if "can't find child" in ln.lower()]

# Cluster indices (reuse but minimal output)
def cluster(idxs, gap=30):
    idxs=sorted(idxs)
    clusters=[]
    cur=[]
    for idx in idxs:
        if not cur or idx-cur[-1] <= gap:
            cur.append(idx)
        else:
            clusters.append(cur)
            cur=[idx]
    if cur:
        clusters.append(cur)
    return clusters

init_clusters = cluster(init_err_idxs)
cant_clusters = cluster(cantfind_idxs)
print("\nInit -2 clusters (start_idx, end_idx, n, start_ts):")
for cl in init_clusters:
    print(cl[0], cl[-1], len(cl), get_ts(lines[cl[0]]))

print("\nCan't-find-child clusters (start_idx, end_idx, n, start_ts):")
for cl in cant_clusters:
    print(cl[0], cl[-1], len(cl), get_ts(lines[cl[0]]))

# For each cluster, find lifecycle hits within +/- 80 lines
lifecycle_idx_set = [i for i,_ in lifecycle_hits]

def nearby_lifecycle(center, radius=80):
    return [(i, lines[i]) for i in lifecycle_idx_set if abs(i-center) <= radius]

print("\nNearby lifecycle lines around each init -2 cluster start (±80 lines):")
for cl in init_clusters:
    center = cl[0]
    near = nearby_lifecycle(center, radius=80)
    print(f"\nCluster at line {center} ts={get_ts(lines[center])} -> near lifecycle hits: {len(near)}")
    for i, ln in near[:12]:
        print(i, ln)

print("\nNearby lifecycle lines around each can't-find-child cluster start (±80 lines):")
for cl in cant_clusters:
    center = cl[0]
    near = nearby_lifecycle(center, radius=80)
    print(f"\nCluster at line {center} ts={get_ts(lines[center])} -> near lifecycle hits: {len(near)}")
    for i, ln in near[:12]:
        print(i, ln)

# --- 3) Find startup banner lines mentioning mod_jk2 version ---
banner = [ln for ln in lines if 'configured --' in ln.lower() or 'server built' in ln.lower() or 'apache/' in ln.lower() or 'mod_jk2' in ln.lower()]
print("\nPotential banner/version lines (first 30):")
for ln in banner[:30]:
    print(ln)

# --- 4) Use sub-LLM to interpret jk2 error state codes and init -2 ---
# Keep prompts short and targeted
prompts = [
    "In Apache mod_jk2/jk2 logs, what does 'mod_jk child workerEnv in error state 6' typically indicate? Provide likely causes.",
    "In Apache mod_jk2/jk2 logs, interpret 'mod_jk child init 1 -2' (what is -2 likely referring to, and common root causes).",
    "In jk2_init(), what does 'Can't find child <pid> in scoreboard' imply about Apache scoreboard/shared memory state and what typically triggers it?",
]
responses = llm_query_batched(prompts)
for p,r in zip(prompts, responses):
    print("\n--- LLM prompt ---\n", p)
    print("--- LLM response ---\n", r[:1200])

