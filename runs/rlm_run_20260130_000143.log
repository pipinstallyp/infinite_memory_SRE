import re, collections
lines = log_content.splitlines()

# Helper to print a window
def show_window(center_idx, before=20, after=25):
    start=max(0, center_idx-before)
    end=min(len(lines), center_idx+after+1)
    return "\n".join(lines[start:end])

init_err_idxs = [i for i,ln in enumerate(lines) if "mod_jk child init 1 -2" in ln.lower()]
cantfind_idxs = [i for i,ln in enumerate(lines) if "can't find child" in ln.lower()]

print("init -2 idxs:", init_err_idxs)
print("can't find idxs:", cantfind_idxs)

# Group nearby indices into clusters to avoid printing repetitive windows
def cluster(idxs, gap=30):
    idxs=sorted(idxs)
    clusters=[]
    cur=[]
    for i in idxs:
        if not cur or i-cur[-1] <= gap:
            cur.append(i)
        else:
            clusters.append(cur)
            cur=[i]
    if cur:
        clusters.append(cur)
    return clusters

print("\nInit error clusters:")
for cl in cluster(init_err_idxs):
    print(cl[0], "..", cl[-1], "(n=", len(cl), ")")

print("\nCan't-find-child clusters:")
for cl in cluster(cantfind_idxs):
    print(cl[0], "..", cl[-1], "(n=", len(cl), ")")

# Print context around first index of each cluster (and around last too)
print("\n=== Context around each init -2 cluster ===")
for cl in cluster(init_err_idxs):
    for idx in [cl[0], cl[-1]] if cl[-1]!=cl[0] else [cl[0]]:
        print("\n--- window around line", idx, "---")
        print(show_window(idx, before=25, after=25))

print("\n=== Context around each Can't-find-child cluster ===")
for cl in cluster(cantfind_idxs):
    for idx in [cl[0], cl[-1]] if cl[-1]!=cl[0] else [cl[0]]:
        print("\n--- window around line", idx, "---")
        print(show_window(idx, before=25, after=25))

# Search for apache lifecycle / signals / restarts
