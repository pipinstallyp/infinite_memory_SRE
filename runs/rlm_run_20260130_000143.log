import re, collections
lines = log_content.splitlines()

# Find all lines mentioning jk/mod_jk besides the simple error-state line
jk_lines = [ln for ln in lines if 'jk' in ln.lower() or 'mod_jk' in ln.lower()]
print('Total jk-related lines:', len(jk_lines))
print('Sample jk-related lines (first 30):')
print('\n'.join(jk_lines[:30]))

# Search for keywords that might indicate underlying cause
keywords = ['connect', 'refused', 'timeout', 'dns', 'resolve', 'ajp', 'tomcat', 'socket', 'errno', 'parse', 'invalid', 'fail', 'error', 'warn']
kw_hits = {kw: [] for kw in keywords}
for ln in jk_lines:
    l = ln.lower()
    for kw in keywords:
        if kw in l:
            kw_hits[kw].append(ln)

for kw in keywords:
    print(f"\n--- keyword '{kw}' hits: {len(kw_hits[kw])} ---")
    # print up to 8 distinct examples
    ex = []
    seen=set()
    for ln in kw_hits[kw]:
        msg = re.sub(r'^\[[^\]]+\]\s+\[[^\]]+\]\s*', '', ln)
        if msg not in seen:
            seen.add(msg)
            ex.append(ln)
        if len(ex) >= 8:
            break
    if ex:
        print('\n'.join(ex))

# Extract other error messages containing mod_jk but not the workerEnv error state
other_modjk_errors = []
for ln in lines:
    if 'mod_jk' in ln.lower() and '] [error]' in ln.lower() and 'workerenv in error state' not in ln.lower():
        other_modjk_errors.append(ln)
print('\nOther mod_jk error lines:', len(other_modjk_errors))
print('\n'.join(other_modjk_errors[:30]))

# Show context window around a few error state transitions where state changes (6->7 etc)
state_re = re.compile(r'error state (\d+)')
states = []
for i,ln in enumerate(lines):
    if 'mod_jk child workerEnv in error state' in ln:
        m = state_re.search(ln)
        if m:
            states.append((i,int(m.group(1)),ln))
print('\nTotal workerEnv error-state entries:', len(states))
print('Distinct states:', sorted(set(s for _,s,_ in states)))

# Pick first occurrence of each distinct state and print context
printed=0
seen_states=set()
for idx,st,ln in states:
    if st in seen_states:
        continue
    seen_states.add(st)
    start=max(0, idx-4)
    end=min(len(lines), idx+5)
    print(f"\n=== Context for first error state {st} at line {idx} ===")
    print('\n'.join(lines[start:end]))
    printed += 1
    if printed >= 6:
        break
