for line in log_lines:
    # Extract log level between [brackets] using regex
    match = re.search(r'\[(\w+)\]', line)
    if match:
        level = match.group(1)
        log_level_counts[level] = log_level_counts.get(level, 0) + 1

# Show first 3 and last 3 log entries
