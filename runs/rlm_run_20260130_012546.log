import re, collections, datetime

text = log_content
lines = text.splitlines()
print('Total chars:', len(text))
print('Total lines:', len(lines))
print('First 5 lines:')
for l in lines[:5]:
    print(l)
print('\nLast 5 lines:')
for l in lines[-5:]:
    print(l)

# Count log levels like [error], [notice], [warn]
level_re = re.compile(r'\[(error|notice|warn|info|debug)\]')
levels = collections.Counter()
for l in lines:
    m = level_re.search(l)
    if m:
        levels[m.group(1)] += 1
print('\nLevel counts:', levels)

# Extract error lines
error_lines = [l for l in lines if '[error]' in l]
print('Error lines:', len(error_lines))
print('\nSample error lines:')
for l in error_lines[:20]:
    print(l)

# Top error messages (strip timestamp/prefix)
msg_counter = collections.Counter()
for l in error_lines:
    # remove leading timestamp and module part
    msg = re.sub(r'^\[[^\]]+\]\s*\[[^\]]+\]\s*', '', l)
    msg_counter[msg] += 1
print('\nTop 15 error messages:')
for msg, cnt in msg_counter.most_common(15):
    print(cnt, msg)

# Try to parse timestamps to find range
# Format: [Sun Dec 04 04:47:44 2005]
time_re = re.compile(r'^\[([A-Za-z]{3})\s+([A-Za-z]{3})\s+(\d{2})\s+(\d{2}:\d{2}:\d{2})\s+(\d{4})\]')
months = {m:i for i,m in enumerate(['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], start=1)}
parsed_times = []
for l in lines:
    m = time_re.match(l)
    if m:
        mon = months[m.group(2)]
        day = int(m.group(3))
        year = int(m.group(5))
        hh,mm,ss = map(int, m.group(4).split(':'))
        parsed_times.append(datetime.datetime(year, mon, day, hh, mm, ss))
if parsed_times:
    print('\nTime range:', min(parsed_times), 'to', max(parsed_times))
    print('Unique days:', len({t.date() for t in parsed_times}))
else:
    print('No timestamps parsed')
