import re, itertools, collections

lines = log_content.splitlines()

# find first occurrence index of each error state
state_re = re.compile(r'mod_jk child workerEnv in error state (\d+)')
first_idx = {}
for i,l in enumerate(lines):
    m = state_re.search(l)
    if m and m.group(1) not in first_idx:
        first_idx[m.group(1)] = i

print("First occurrence per error state:", dict(sorted(first_idx.items(), key=lambda kv:int(kv[0]))))

def show_context(idx, before=6, after=6):
    start = max(0, idx-before)
    end = min(len(lines), idx+after+1)
    for j in range(start,end):
        prefix = ">>" if j==idx else "  "
        print(f"{prefix} {j:04d} {lines[j]}")
    print("-"*120)

for st in sorted(first_idx, key=lambda x:int(x)):
    print(f"\n=== Context for error state {st} (idx {first_idx[st]}) ===")
    show_context(first_idx[st])

# Search for likely root-cause keywords
keywords = [
    "jk", "jk2", "worker", "workers2.properties", "channel", "socket", "connect", "refused",
    "timeout", "errno", "No such file", "permission", "shm", "shared", "ajp", "tomcat",
    "map", "uri", "balancer", "lb", "dns", "resolve", "malloc", "segfault", "core"
]
hits = collections.Counter()
for l in lines:
    low = l.lower()
    for k in keywords:
        if k.lower() in low:
            hits[k] += 1

print("\nKeyword hit counts (top 20):")
for k,c in hits.most_common(20):
    print(f"{c:5d} {k}")

# Show non-standard error lines beyond the generic "error state" ones
generic_re = re.compile(r'mod_jk child workerEnv in error state \d+')
other_errors = [l for l in lines if "[error]" in l and not generic_re.search(l)]
print("\nNon-generic [error] lines:", len(other_errors))
for l in other_errors[:60]:
    print(l)
