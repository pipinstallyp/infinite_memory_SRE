# Helper to print context around any regex match in msg
def show_context(match_fn, n=3, before=6, after=6):
    idxs = [i for i,(ts,sev,msg) in enumerate(parsed) if match_fn(ts,sev,msg)]
    print("matches:", len(idxs))
    for j,i in enumerate(idxs[:n]):
        print("\n--- context", j, "at", parsed[i][0], "---")
        for k in range(max(0,i-before), min(len(parsed), i+after+1)):
            ts,sev,msg = parsed[k]
            prefix = ">>" if k==i else "  "
            print(f"{prefix} {ts} [{sev}] {msg}")

print("\nContext: jk2_init() Can't find child ... in scoreboard")
show_context(lambda ts,sev,msg: sev=="error" and "Can't find child" in msg, n=5)

print("\nContext: mod_jk child init")
show_context(lambda ts,sev,msg: sev=="error" and msg.startswith("mod_jk child init"), n=5)

# What lines contain 'core'?
