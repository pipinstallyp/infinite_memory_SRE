import re, datetime as dt
from collections import Counter, defaultdict

# Build quick indexes of key events
init_idxs = [i for i,(ts,sev,msg) in enumerate(parsed) if sev=="notice" and msg.startswith("workerEnv.init() ok")]
err_state_idxs = [i for i,(ts,sev,msg) in enumerate(parsed) if sev=="error" and msg.startswith("mod_jk child workerEnv in error state")]
score_err_idxs = [i for i,(ts,sev,msg) in enumerate(parsed) if sev=="error" and msg.startswith("jk2_init() Can't find child")]

print("Counts: init", len(init_idxs), "err_state", len(err_state_idxs), "score_err", len(score_err_idxs))

# For each init, find nearest following error state within 60s
follow_delta = []
no_follow = 0
for i in init_idxs:
    ts0 = parsed[i][0]
    # scan forward a bit
    found = None
    for j in range(i+1, min(len(parsed), i+30)):
        ts,sev,msg = parsed[j]
        if (ts-ts0).total_seconds() > 60:
            break
        if sev=="error" and msg.startswith("mod_jk child workerEnv in error state"):
            found = (ts-ts0).total_seconds()
            break
    if found is None:
        no_follow += 1
    else:
        follow_delta.append(found)

import statistics as stats
print("init->err_state within 60s:", len(follow_delta), "/", len(init_idxs), "missing:", no_follow)
if follow_delta:
    print("  delta stats (s): min", min(follow_delta), "median", stats.median(follow_delta), "p90", sorted(follow_delta)[int(0.9*len(follow_delta))-1], "max", max(follow_delta))

# Correlate score_err bursts with error state codes within +-10s
state_re = re.compile(r'error state (\d+)')

corr = Counter()
for si in score_err_idxs:
    ts0 = parsed[si][0]
    for j in range(max(0, si-20), min(len(parsed), si+20)):
        ts,sev,msg = parsed[j]
        if abs((ts-ts0).total_seconds()) <= 10 and sev=="error":
            m = state_re.search(msg)
            if m:
                corr[int(m.group(1))] += 1
print("\nError-state codes observed within 10s of scoreboard errors:", corr)

# Hourly counts of err_state (dominant) to see whether this is chronic or spike-y
by_hour = Counter()
for ts,sev,msg in parsed:
    if sev=="error" and msg.startswith("mod_jk child workerEnv in error state"):
        by_hour[(ts.date(), ts.hour)] += 1
print("\nTop 10 hours by err_state volume:")
for (d,h),c in by_hour.most_common(10):
    print(f"{d} {h:02d}:00  {c}")

# Show unique raw messages (not normalized) for errors to ensure nothing is hidden
raw_err = Counter(msg for _,sev,msg in parsed if sev=="error")
print("\nRaw unique error messages:", len(raw_err))
for msg,c in raw_err.most_common(20):
    print(f"{c:4d} {msg}")

# Ask sub-LLM for semantic interpretation of these mod_jk2 errors
sample_block = "\n".join(lines[:80])
# Add one representative burst around scoreboard error
burst_idx = score_err_idxs[0] if score_err_idxs else err_state_idxs[0]
burst_start = max(0, burst_idx-15); burst_end = min(len(lines), burst_idx+25)
burst_block = "\n".join(lines[burst_start:burst_end])

prompt = f"""You are an expert in Apache httpd mod_jk/mod_jk2.
Given these log snippets, explain what 'mod_jk child workerEnv in error state N' means (esp. states 6-10) and what 'mod_jk child init 1 -2' indicates.
Then infer the most likely root cause(s) consistent with these logs, prioritizing scoreboard/shared-memory issues vs configuration issues.

Snippet A (start of log):\n{sample_block}\n\nSnippet B (around a scoreboard error burst):\n{burst_block}\n"""

