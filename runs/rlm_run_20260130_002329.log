import re
from collections import Counter, defaultdict

# Count workerEnv error state codes
state_re = re.compile(r'mod_jk child workerEnv in error state (\d+)')
state_counts = Counter()
state_times = defaultdict(list)

for ts, sev, msg in parsed:
    if sev != "error": 
        continue
    m = state_re.search(msg)
    if m:
        s = int(m.group(1))
        state_counts[s] += 1
        state_times[s].append(ts)

print("workerEnv error state counts:", state_counts)

# Count child init codes like: mod_jk child init 1 -2
init_re = re.compile(r'mod_jk child init (\S+)\s+(\S+)')
init_counts = Counter()
init_examples = defaultdict(list)
for ts, sev, msg in parsed:
    if sev != "error": 
        continue
    m = init_re.match(msg)
    if m:
        a,b = m.group(1), m.group(2)
        init_counts[(a,b)] += 1
        if len(init_examples[(a,b)]) < 3:
            init_examples[(a,b)].append((ts,msg))

print("\nchild init code counts:", init_counts)
for k,v in init_counts.items():
    print(" ", k, "->", v, "examples:", init_examples[k])

# Print first/last 30 lines to see if any other patterns are there
print("\n=== First 30 lines ===")
print("\n".join(lines[:30]))
print("\n=== Last 50 lines ===")
print("\n".join(lines[-50:]))

# Analyze cadence: how often are error state messages logged? distribution of gaps for the dominant state
dominant_state = state_counts.most_common(1)[0][0] if state_counts else None
if dominant_state is not None:
    times = sorted(state_times[dominant_state])
    gaps = [(times[i+1]-times[i]).total_seconds() for i in range(len(times)-1)]
    gap_counts = Counter(int(g) for g in gaps)  # seconds
    print(f"\nDominant state {dominant_state} gap stats (seconds):")
    if gaps:
        import statistics as stats
        print("  count:", len(gaps), "min:", min(gaps), "median:", stats.median(gaps), "p90:", sorted(gaps)[int(0.9*len(gaps))-1], "max:", max(gaps))
        print("  most common integer gaps:", gap_counts.most_common(10))

# How many unique child PIDs seen?
found_child_re = re.compile(r'jk2_init\(\) Found child (\d+) in scoreboard slot (\d+)')
pids = set()
slot_counts = Counter()
for ts, sev, msg in parsed:
    m = found_child_re.match(msg)
    if m:
        pids.add(int(m.group(1)))
        slot_counts[int(m.group(2))] += 1
print("\nUnique child PIDs seen in scoreboard:", len(pids))
print("Most common scoreboard slots:", slot_counts.most_common(10))
print("Min/Max PID seen:", (min(pids), max(pids)) if pids else None)

# Show a few tight clusters around periods where error states are not 6 (e.g., 8 or 9)
for s in sorted(state_counts):
    if s == dominant_state: 
        continue
    # show first occurrence context
    idx = next(i for i,(ts,sev,msg) in enumerate(parsed) if sev=="error" and f"error state {s}" in msg)
    print(f"\n--- First occurrence of error state {s} at {parsed[idx][0]} ---")
    for k in range(max(0, idx-8), min(len(parsed), idx+8)):
        ts,sev,msg = parsed[k]
        prefix = ">>" if k==idx else "  "
        print(f"{prefix} {ts} [{sev}] {msg}")
