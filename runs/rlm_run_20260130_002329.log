import re, datetime as dt
from collections import Counter, defaultdict

text = log_content
lines = text.splitlines()
print("Total chars:", len(text))
print("Total lines:", len(lines))
print("First 5 lines:")
print("\n".join(lines[:5]))
print("\nLast 5 lines:")
print("\n".join(lines[-5:]))

# Parse timestamps like: [Sun Dec 04 04:47:44 2005] [error] ...
ts_re = re.compile(r'^\[(?P<dow>\w{3}) (?P<mon>\w{3}) (?P<day>\d{2}) (?P<time>\d{2}:\d{2}:\d{2}) (?P<year>\d{4})\] \[(?P<sev>\w+)\] (?P<msg>.*)$')
months = {m:i for i,m in enumerate(["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"], start=1)}

parsed = []
bad = 0
for ln in lines:
    m = ts_re.match(ln)
    if not m:
        bad += 1
        continue
    d = int(m.group("day"))
    mon = months.get(m.group("mon"), 1)
    year = int(m.group("year"))
    t = m.group("time")
    hh,mm,ss = map(int, t.split(":"))
    ts = dt.datetime(year, mon, d, hh, mm, ss)
    parsed.append((ts, m.group("sev").lower(), m.group("msg")))

print("Parsed lines:", len(parsed), "Unparsed:", bad)
if parsed:
    print("Time range:", parsed[0][0], "->", parsed[-1][0])

sev_counts = Counter(sev for _,sev,_ in parsed)
print("Severity counts:", sev_counts)

# Top 20 error messages (normalized a bit)
def normalize(msg):
    msg = re.sub(r'\b\d+\b', '<num>', msg)
    msg = re.sub(r'0x[0-9a-fA-F]+', '0x<hex>', msg)
    msg = re.sub(r'\s+', ' ', msg).strip()
    return msg

err_msgs = Counter(normalize(msg) for _,sev,msg in parsed if sev in ("error","crit","alert","emerg"))
print("\nTop 15 error patterns:")
for msg,c in err_msgs.most_common(15):
    print(c, msg[:200])
