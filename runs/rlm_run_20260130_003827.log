import re, collections, datetime

lines = log_content.splitlines()
pat = re.compile(r'^\[([A-Za-z]{3} [A-Za-z]{3} +\d{2} \d{2}:\d{2}:\d{2} \d{4})\] \[([a-zA-Z]+)\] ?(.*)$')

parsed=[]
for i,ln in enumerate(lines):
    m=pat.match(ln)
    if m:
        ts=datetime.datetime.strptime(m.group(1), "%a %b %d %H:%M:%S %Y")
        lvl=m.group(2).lower()
        msg=m.group(3)
        parsed.append((i,ts,lvl,msg))

# Top NOTICE messages (normalized)
def normalize(msg):
    msg = re.sub(r'\b\d+\b', '<num>', msg)
    msg = re.sub(r'\s+', ' ', msg).strip()
    return msg

notice_msgs = [msg for _,_,lvl,msg in parsed if lvl=="notice"]
notice_counts = collections.Counter(normalize(m) for m in notice_msgs)
print("Top 25 normalized NOTICE messages:")
for msg,cnt in notice_counts.most_common(25):
    print(cnt, msg[:200])

# Search for other potentially relevant substrings
subs = ["scoreboard", "shm", "shared", "socket", "errno", "connect", "refus", "timeout", "ajp", "tomcat", "worker", "channel", "lb", "mount", "uri", "jkstatus", "pid", "signal", "segfault", "core"]
sub_hits = collections.Counter()
for ln in lines:
    low=ln.lower()
    for s in subs:
        if s in low:
            sub_hits[s]+=1
print("\nSubstring hits (nonzero):")
for k,v in sub_hits.most_common():
    if v:
        print(k, v)

def show_context_idx(i, n=4):
    start=max(0,i-n); end=min(len(lines), i+n+1)
    return "\n".join(lines[start:end])

# Find and show contexts for "mod_jk child init 1 -2"
for i,ts,lvl,msg in parsed:
    if lvl=="error" and "mod_jk child init 1 -2" in msg:
        print("\nContext for:", msg, "at", ts, "line", i)
        print(show_context_idx(i, n=6))
        break

# Show first few "Can't find child" contexts
cnt=0
for i,ts,lvl,msg in parsed:
    if "Can't find child" in msg:
        print("\nContext for:", msg, "at", ts, "line", i)
        print(show_context_idx(i, n=6))
        cnt+=1
        if cnt>=3:
            break

# What messages occur right before error state?
err_state_idxs=[(i,ts,msg) for i,ts,lvl,msg in parsed if lvl=="error" and "workerEnv in error state" in msg]
print("\nFirst 5 error-state lines and their previous 2 log lines:")
for i,ts,msg in err_state_idxs[:5]:
    print("\n@", ts, msg)
    print("\n".join(lines[max(0,i-2):i+1]))

# Time aggregation: errors per minute and top minute
per_min=collections.Counter()
for i,ts,lvl,msg in parsed:
    if lvl=="error" and "workerEnv in error state" in msg:
        per_min[ts.replace(second=0)] += 1
top_minutes=per_min.most_common(10)
print("\nTop 10 minutes by workerEnv error count:")
for t,c in top_minutes:
    print(t, c)

# Show around top burst minute
if top_minutes:
    burst_t=top_minutes[0][0]
    idxs=[i for i,ts,lvl,msg in parsed if ts.replace(second=0)==burst_t]
    if idxs:
        center=idxs[0]
        print("\nContext around first log line in top burst minute", burst_t, "line", center)
        print(show_context_idx(center, n=12))
