import re, collections, datetime, itertools, statistics

lines = log_content.splitlines()
pat = re.compile(r'^\[([A-Za-z]{3} [A-Za-z]{3} +\d{2} \d{2}:\d{2}:\d{2} \d{4})\] \[([a-zA-Z]+)\] ?(.*)$')

parsed=[]
for i,ln in enumerate(lines):
    m=pat.match(ln)
    if m:
        ts=datetime.datetime.strptime(m.group(1), "%a %b %d %H:%M:%S %Y")
        lvl=m.group(2).lower()
        msg=m.group(3)
        parsed.append((i,ts,lvl,msg))

def normalize(msg):
    msg = re.sub(r'\b\d+\b', '<num>', msg)
    msg = re.sub(r'0x[0-9a-fA-F]+', '0x<hex>', msg)
    msg = re.sub(r'\s+', ' ', msg).strip()
    return msg

# Distinct messages overall and by level
overall_counts = collections.Counter((lvl, normalize(msg)) for _,_,lvl,msg in parsed)
print("Total distinct normalized messages:", len(overall_counts))

# Show notice messages excluding the 2 dominant ones
notice_norm = collections.Counter(normalize(msg) for _,_,lvl,msg in parsed if lvl=="notice")
dominant = {"jk2_init() Found child <num> in scoreboard slot <num>",
            "workerEnv.init() ok /etc/httpd/conf/workers2.properties"}
print("\nNOTICE messages excluding the 2 dominant patterns:")
others = [(m,c) for m,c in notice_norm.items() if m not in dominant]
others_sorted = sorted(others, key=lambda x:(-x[1], x[0]))
print("Count of other notice patterns:", len(others_sorted))
for m,c in others_sorted[:40]:
    print(c, m[:220])

# Show error messages excluding workerEnv error state patterns
err_norm = collections.Counter(normalize(msg) for _,_,lvl,msg in parsed if lvl=="error")
print("\nERROR messages excluding 'workerEnv in error state':")
err_others = [(m,c) for m,c in err_norm.items() if "workerEnv in error state" not in m]
for m,c in sorted(err_others, key=lambda x:(-x[1], x[0]))[:40]:
    print(c, m[:240])

# Find first occurrence of each error state N and show context
def show_context(i, n=6):
    return "\n".join(lines[max(0,i-n):min(len(lines), i+n+1)])

state_first = {}
state_pat = re.compile(r'workerEnv in error state (\d+)')
for i,ts,lvl,msg in parsed:
    if lvl!="error": 
        continue
    m = state_pat.search(msg)
    if m:
        st = int(m.group(1))
        if st not in state_first:
            state_first[st] = (i,ts,msg)
for st in sorted(state_first):
    i,ts,msg = state_first[st]
    print(f"\nFirst error state {st} at {ts} (line {i}): {msg}")
    print(show_context(i, n=5))

# Analyze "Found child <num>" values
found_pat = re.compile(r'jk2_init\(\) Found child (\d+) in scoreboard slot (\d+)')
found = []
for i,ts,lvl,msg in parsed:
    m=found_pat.search(msg)
    if m:
        found.append((i,ts,int(m.group(1)), int(m.group(2))))
print("\nFound-child entries:", len(found))
if found:
    pids = [pid for _,_,pid,_ in found]
    slots = [slot for *_,slot in found]
    print("Child id stats: unique:", len(set(pids)), "min:", min(pids), "max:", max(pids), "median:", statistics.median(pids))
    print("Slot stats: unique:", len(set(slots)), "min:", min(slots), "max:", max(slots))
    # show first 10 and last 10
    print("\nFirst 10 found-child lines (ts, child, slot):")
    for _,ts,pid,slot in found[:10]:
