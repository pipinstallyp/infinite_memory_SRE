import re, collections, datetime, statistics, textwrap

s = log_content
print("Total chars:", len(s))
lines = s.splitlines()
print("Total lines:", len(lines))
print("First 5 lines:")
print("\n".join(lines[:5]))
print("\nLast 5 lines:")
print("\n".join(lines[-5:]))

# Parse lines like: [Sun Dec 04 04:47:44 2005] [error] message
pat = re.compile(r'^\[([A-Za-z]{3} [A-Za-z]{3} +\d{2} \d{2}:\d{2}:\d{2} \d{4})\] \[([a-zA-Z]+)\] ?(.*)$')
levels = collections.Counter()
unparsed = 0
msgs_by_level = collections.defaultdict(list)
times = []
for ln in lines:
    m = pat.match(ln)
    if not m:
        unparsed += 1
        continue
    ts, lvl, msg = m.group(1), m.group(2).lower(), m.group(3)
    levels[lvl] += 1
    msgs_by_level[lvl].append(msg)
    # parse time
    try:
        t = datetime.datetime.strptime(ts, "%a %b %d %H:%M:%S %Y")
        times.append(t)
    except Exception:
        pass

print("\nParsed levels:", levels)
print("Unparsed lines:", unparsed)
if times:
    print("Time range:", min(times), "->", max(times), "(", (max(times)-min(times)), ")")

# Top error messages (normalized a bit)
def normalize(msg):
    msg = re.sub(r'\b\d+\b', '<num>', msg)
    msg = re.sub(r'0x[0-9a-fA-F]+', '0x<hex>', msg)
    msg = re.sub(r'\s+', ' ', msg).strip()
    return msg

top_err = collections.Counter(normalize(m) for m in msgs_by_level.get('error', []))
print("\nTop 20 normalized error messages:")
for msg, cnt in top_err.most_common(20):
    print(cnt, msg[:180])

# Also look for key substrings
keywords = ["mod_jk", "jk2", "segfault", "child", "proxy", "timeout", "premature", "connection reset", "broken pipe", "file does not exist", "core dump", "panic", "Out of memory", "cannot", "refused"]
hits = {k:0 for k in keywords}
for ln in lines:
    low = ln.lower()
    for k in keywords:
        if k.lower() in low:
            hits[k]+=1
print("\nKeyword hits (nonzero):")
for k,v in sorted(hits.items(), key=lambda kv: -kv[1]):
    if v:
        print(k, v)
